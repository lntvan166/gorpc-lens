{
  "name": "gorpc-lens",
  "displayName": "gorpc-lens",
  "description": "Jump from a Go gRPC client call to the handler that actually runs.",
  "version": "0.2.0",
  "publisher": "lntvan166",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lntvan166/gorpc-lens"
  },
  "bugs": {
    "url": "https://github.com/lntvan166/gorpc-lens/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "go",
    "golang",
    "grpc",
    "protobuf",
    "microservices",
    "monorepo",
    "go-to-definition",
    "navigation",
    "gopls",
    "go.work"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:proto",
    "workspaceContains:**/*.proto"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gorpcLens.goToDefinition",
        "title": "gorpc-lens: Go to Definition (skip generated files)"
      },
      {
        "command": "gorpcLens.goToHandler",
        "title": "gorpc-lens: Go to gRPC Handler"
      },
      {
        "command": "gorpcLens.findCallers",
        "title": "gorpc-lens: Find gRPC Callers"
      },
      {
        "command": "gorpcLens.goToProto",
        "title": "gorpc-lens: Go to Proto Definition"
      }
    ],
    "keybindings": [
      {
        "command": "gorpcLens.goToDefinition",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus && editorLangId == go"
      },
      {
        "command": "gorpcLens.goToDefinition",
        "key": "f12",
        "when": "editorTextFocus && editorLangId == go"
      },
      {
        "command": "gorpcLens.goToHandler",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus && editorLangId == go"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "gorpcLens.submenu",
          "group": "navigation@100",
          "when": "editorLangId == go"
        }
      ],
      "gorpcLens.submenu": [
        {
          "command": "gorpcLens.goToDefinition",
          "group": "1_nav@0"
        },
        {
          "command": "gorpcLens.goToHandler",
          "group": "1_nav@1"
        },
        {
          "command": "gorpcLens.findCallers",
          "group": "1_nav@2"
        },
        {
          "command": "gorpcLens.goToProto",
          "group": "1_nav@3"
        }
      ]
    },
    "submenus": [
      {
        "id": "gorpcLens.submenu",
        "label": "gRPC"
      }
    ],
    "configuration": {
      "title": "gorpc-lens",
      "properties": {
        "gorpcLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable gorpc-lens navigation."
        },
        "gorpcLens.ignoreGeneratedFiles": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Drop generated files (see `#gorpcLens.excludeGlobs#`) from the results of **gorpc-lens: Go to Definition**. If every result is generated, they are shown anyway rather than leaving you with nowhere to go. This cannot apply to Ctrl+Click, which no extension can filter."
        },
        "gorpcLens.timeoutMs": {
          "type": "number",
          "default": 2000,
          "description": "Give up on a gopls query after this many milliseconds and contribute nothing."
        },
        "gorpcLens.includeTests": {
          "type": "boolean",
          "default": false,
          "description": "Include results in _test.go files."
        },
        "gorpcLens.codeLens.handlers": {
          "type": "boolean",
          "default": false,
          "description": "Show a caller-count CodeLens above gRPC handler methods."
        },
        "gorpcLens.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.pb.go"
          ],
          "description": "Results in files matching these globs are treated as generated code and dropped."
        },
        "gorpcLens.trace": {
          "type": "string",
          "enum": [
            "off",
            "verbose"
          ],
          "default": "off",
          "description": "Log each resolution stage and its timing to the gorpc-lens output channel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile-tests": "tsc -p .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run compile-tests && mocha",
    "test:integration": "npm run build && npm run compile-tests && node out/test/integration/runTest.js",
    "verify:real": "npm run build && npm run compile-tests && node out/test/integration/runReal.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.2",
    "mocha": "^10.4.0",
    "typescript": "^5.4.5"
  },
  "extensionKind": [
    "workspace"
  ]
}
